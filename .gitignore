# Ignore everything by default
*

# Allow Git to traverse directories
!*/

# Track scripts and documents
!*.R
!*.Rmd
!*.qmd
!*.md
!*.ipynb

# Track results and metadata
!*.csv
!*.png
!*.pdf
!*.xlsx
!*.txt

# Keep this file
!.gitignore

# Keep README files
!README*

# Large data objects (not suitable for GitHub)
*.qs
*.rds
*.rda
*.h5ad
**/Objects/

# IDE and session files
.Rproj.user/
.Rhistory
*.Rproj
*.pper
*.log

# Large standalone data directories
Neighborhood_FSD/
Round_7/data/

# PDFs over GitHub's 100 MB file limit
Round_1/Plots/Adult_2_report.pdf
Round_1/Plots/Neonate_2_report_GroupsAdded.pdf
Round_3/Plots/Neonate IFN and RSV reinfected_vs_Adult reinfected_report.pdf
Round_6/Plots/Bcell_marker_by_Group_TMA.pdf
